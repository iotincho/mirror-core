FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY pyproject.toml README.md alembic.ini ./
COPY src ./src
COPY migrations ./migrations

RUN pip install --upgrade pip \
    && pip install . \
    && groupadd --system el-espejo \
    && useradd --system --gid el-espejo --create-home el-espejo \
    && mkdir -p /data/documents /data/audio-notes /data/extractions /data/reflections /data/users \
    && chown -R el-espejo:el-espejo /app /data

USER el-espejo

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "from urllib.request import urlopen; urlopen('http://127.0.0.1:8000/health')"

CMD ["uvicorn", "src.main:app", "--host", "0.0.0.0", "--port", "8000"]
