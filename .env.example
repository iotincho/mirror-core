# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
DOCUMENTS_PATH=/data/documents
AUDIO_NOTES_PATH=/data/audio-notes
EXTRACTIONS_PATH=/data/extractions
API_PORT=8000

# PostgreSQL stores users, OAuth identities and revocable sessions.
POSTGRES_DB=el_espejo
POSTGRES_USER=el_espejo
POSTGRES_PASSWORD=el-espejo-local-password
DATABASE_URL=postgresql+asyncpg://el_espejo:el-espejo-local-password@localhost:5432/el_espejo

# Structured extraction. Set these only when you intentionally use the OpenAI provider.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
# The transcription provider accepts files up to 25 MB.
AUDIO_MAX_UPLOAD_BYTES=26214400
# Per provider adapter and process; replicas multiply the aggregate concurrency.
PROVIDER_MAX_CONCURRENCY=4
PROVIDER_TIMEOUT_SECONDS=120

# Semantic retrieval of extracted claims.
EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
REFLECTION_PROVIDER=openai
# Defaults to OPENAI_MODEL when omitted.
OPENAI_REFLECTION_MODEL=
REFLECTIONS_PATH=data/reflections
# Every user-owned file store is rooted under WORKSPACES_PATH/<user UUID>/.
WORKSPACES_PATH=data/users

# ArcadeDB graph store (the defaults match docker-compose.yml)
ARCADEDB_HTTP_URL=http://localhost:2480
ARCADEDB_DATABASE=el_espejo
ARCADEDB_USERNAME=root
ARCADEDB_ROOT_PASSWORD=el-espejo-local-password
ARCADEDB_INSTANCE_KEY=primary
GRAPH_TIMEOUT_SECONDS=30
# Per workspace runtime HTTP connection pool.
GRAPH_MAX_CONNECTIONS=20

# Optional host-port override for Docker Compose.
ARCADEDB_HTTP_PORT=2480

# Single public entrypoint for the PWA and API reverse proxy
APP_PORT=8080
# Comma-separated development hostnames accepted by Vite behind Nginx
VITE_ALLOWED_HOSTS=localhost

# Required for publicly exposed deployments. Keep this only in .env.local.
# Generate with: openssl rand -hex 32
AUTH_SESSION_SECRET=
# Optional dedicated Fernet key for technical ArcadeDB credentials. If omitted,
# a distinct key is derived from AUTH_SESSION_SECRET.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
WORKSPACE_SECRET_KEY=
AUTH_SESSION_TTL_SECONDS=604800
AUTH_COOKIE_SECURE=true

# Google OAuth is enabled only when all three values below are configured.
# GOOGLE_OAUTH_REDIRECT_URL is the public PWA callback, e.g.
# https://app.example.com/oauth/google/callback. Register that exact URL in Google Cloud.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=
# Optional separate secret for signed OAuth state. Falls back to AUTH_SESSION_SECRET.
GOOGLE_OAUTH_STATE_SECRET=
