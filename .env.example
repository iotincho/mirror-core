# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
# Compose interpolation only; admin-local.sh does not start the public tunnel.
CLOUDFLARE_TUNNEL_TOKEN=REPLACE_WITH_TUNNEL_TOKEN_IF_PUBLIC_TUNNEL_IS_USED
SENTRY_DSN=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=1.0
DOCUMENTS_PATH=/data/documents
AUDIO_NOTES_PATH=/data/audio-notes
API_PORT=8000

# PostgreSQL stores users, OAuth identities and revocable sessions.
POSTGRES_DB=el_espejo
POSTGRES_USER=el_espejo
POSTGRES_PASSWORD=el-espejo-local-password
DATABASE_URL=postgresql+asyncpg://el_espejo:el-espejo-local-password@localhost:5432/el_espejo

# Automatic emotion extraction and audio transcription. Configure OpenAI before uploading notes.
LLM_PROVIDER=openai
DOCUMENT_TITLE_READ_LIMIT=5
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
EMBEDDING_SEGMENTATION_THRESHOLD=2000
EMBEDDING_SECTION_MAX_TOKENS=2000
EMBEDDING_SECTION_TARGET_TOKENS=1000
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
# The transcription provider accepts files up to 25 MB.
AUDIO_MAX_UPLOAD_BYTES=26214400
# Per provider adapter and process; replicas multiply the aggregate concurrency.
PROVIDER_MAX_CONCURRENCY=4
PROVIDER_TIMEOUT_SECONDS=120

# Every user-owned file store is rooted under WORKSPACES_PATH/<user UUID>/.
WORKSPACES_PATH=data/users

# ArcadeDB graph store (the defaults match docker-compose.yml)
ARCADEDB_HTTP_URL=http://localhost:2480
ARCADEDB_DATABASE=el_espejo
ARCADEDB_USERNAME=root
ARCADEDB_ROOT_PASSWORD=el-espejo-local-password
ARCADEDB_INSTANCE_KEY=primary
GRAPH_TIMEOUT_SECONDS=30
# Per workspace runtime HTTP connection pool.
GRAPH_MAX_CONNECTIONS=20

# Optional host-port override for Docker Compose.
ARCADEDB_HTTP_PORT=2480

# Single public entrypoint for the PWA and API reverse proxy
APP_PORT=8080
# Comma-separated development hostnames accepted by Vite behind Nginx
VITE_ALLOWED_HOSTS=localhost

# Required for publicly exposed deployments. Keep this only in .env.local.
# Generate with: openssl rand -hex 32
AUTH_SESSION_SECRET=
# Optional dedicated Fernet key for technical ArcadeDB credentials. If omitted,
# a distinct key is derived from AUTH_SESSION_SECRET.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
WORKSPACE_SECRET_KEY=
AUTH_SESSION_TTL_SECONDS=604800
AUTH_COOKIE_SECURE=true

# Google OAuth is enabled only when all three values below are configured.
# GOOGLE_OAUTH_REDIRECT_URL is the public PWA callback, e.g.
# https://app.example.com/oauth/google/callback. Register that exact URL in Google Cloud.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=
# Optional separate secret for signed OAuth state. Falls back to AUTH_SESSION_SECRET.
GOOGLE_OAUTH_STATE_SECRET=

# Deferred processing (included in docker-compose.yml).
# Compose overrides the URL to use its internal rabbitmq hostname.
RABBITMQ_URL=amqp://processing:processing-local-password@localhost:5672/
PROCESSING_CONCURRENCY=4
PROCESSING_LEASE_SECONDS=90

# Deferred Markdown/text uploads.
DOCUMENT_MAX_UPLOAD_BYTES=5242880

# Optional voluntary writing invitations. NOT generated on API/Compose startup.
# Explicitly generate once, then configure the values below (.env.local for Compose):
# python -m src.exteriorization.vapid /private/path/vapid
# Public key is the contents of public.txt. Private key may be a PEM path mounted
# in API/worker/dispatcher, or a base64 DER value (never commit it).
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=
# JSON array of exact public PWA origins for HTTPS reverse proxies/tunnels.
WEB_PUSH_ALLOWED_ORIGINS=[]
# Optional JSON array of trusted provider hostname suffixes; defaults cover
# Google FCM, Mozilla, Apple and Windows. Never add arbitrary user-controlled hosts.
# WEB_PUSH_ALLOWED_HOSTS=["fcm.googleapis.com","push.services.mozilla.com","push.apple.com","notify.windows.com"]

# Password recovery by short code. API and workers need the same values.
# Verify the sending domain in Resend; never place the API key in the PWA.
RESEND_API_KEY=
AUTH_EMAIL_FROM=
# Independent stable secret, at least 32 characters: openssl rand -hex 32
PASSWORD_RECOVERY_SECRET=
# JSON CIDRs of trusted proxy peers only. Empty means use the direct socket IP.
# Behind Docker/Cloudflare, configure the actual gateway/tunnel network CIDRs.
PASSWORD_RECOVERY_TRUSTED_PROXY_CIDRS=[]

# Optional explicit app-foreground activity, aggregated by user/day (90 days).
PLATFORM_ACTIVITY_ENABLED=false

# Experimental personal-axis backend (previews, approval and automatic note execution).
# Set consistently for API, workers and dispatcher.
PERSONAL_AXES_ENABLED=false
PERSONAL_AXES_PREVIEW_HOURS=72
PERSONAL_AXES_PREVIEW_CONCURRENCY=2
PERSONAL_AXES_MAX_PENDING_PREVIEWS=10
PERSONAL_AXES_MAX_INPUT_CHARS=100000
PERSONAL_AXES_MAX_OUTPUT_TOKENS=6000
# Admin API is a separate LAN-only process. No admin routes in the public app.
ADMIN_INVENTORY_MAX_AGE_SECONDS=300
# Compose interpolation reads .env, also for the optional admin-lan profile.
POSTGRES_PORT=5432
# Set the actual private interface IP; loopback is bound separately.
ADMIN_BIND_ADDRESS=192.168.1.50
ADMIN_PORT=8081
ADMIN_ALLOWED_HOSTS="localhost 127.0.0.1 192.168.1.50"
ADMIN_SYNC_INTERVAL_SECONDS=30
